{
  "manifest_version": 3,
  "name": "Drops Tracker",
  "version": "0.1.0",
  "description": "Shows whether Twitch is really adding Drops minutes right now, and why not when it stalls.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "cookies", "notifications", "scripting", "storage", "webRequest"],
  "host_permissions": ["https://*.twitch.tv/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.twitch.tv/*", "https://m.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://www.twitch.tv/drops/campaigns*"], "js": ["page-hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.twitch.tv/drops/campaigns*"], "js": ["page-bridge.js"], "run_at": "document_start" }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css", "lib/chip.js", "lib/panel.js", "lib/settings.js", "lib/directory.js", "lib/badges.js", "lib/minutelog.js", "lib/debug.js"],
      "matches": ["https://www.twitch.tv/*", "https://m.twitch.tv/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drops Tracker",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
